# Copy this file to .env and fill in real values. Never commit .env
# Port the API listens on
PORT=3000
# development or production (optional)
NODE_ENV=development
# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/smart_parking
# Secret for the login tokens (at least 32 characters)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# How long a login lasts (optional)
JWT_EXPIRES_IN=1h
# Mosquitto broker for the sensors
MQTT_URL=mqtt://localhost:1883
